---
import { ClientRouter } from "astro:transitions";
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Partner from "../components/Partner.astro";
import { anlass } from "../data/anlass";
import { graph, type Brotkrume, type Frage } from "../data/graph";
import { fassungen, kuerzel, pfad, standard, t, type Sprache, type Seite } from "../i18n/sprachen";

interface Props {
  lang: Sprache;
  seite: Seite;
  title: string;
  description: string;
}
const { lang, seite, title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = new URL("/preview.jpg", Astro.site);
const alternativen = fassungen(seite).map((f) => ({ ...f, url: new URL(f.weg, Astro.site).href }));
const standardweg = alternativen.find((f) => f.lang === standard)!.url;

/* ---------- Auszeichnung, ein Graph je Seite ----------
   Grundlage: docs/YL-SGU-2026-002_Schema-Plan.md. Dieses Gerüst trägt die
   zwölf indexierbaren Seiten. Die Anmeldung und die zwölf Rechtstexte
   laufen über eigene Gerüste und tragen kein Schema, sie tragen noindex. */
const w = t(lang);
const voll = (weg: string) => new URL(weg.endsWith("/") ? weg : `${weg}/`, Astro.site).href;

/* Brotkrumen bilden Hierarchie ab, nie Sprungmarken. Zwei Stufen. */
const brotkrumen: Brotkrume[] = seite === "start" ? [] : [
  { name: anlass.name, url: voll(pfad(lang, "start")) },
  { name: w.nav[seite as "kulinarik" | "wein" | "organisation"], url: voll(pfad(lang, seite)) },
];

/* Hauptentität je Unterseite */
const hauptsache = seite === "kulinarik" ? "alain-lerjen"
  : seite === "wein" ? "alisha-cina" : undefined;

/* Die Fragen kommen wörtlich aus dem sichtbaren Fragenblock. Nichts
   umgeschrieben, nichts gekürzt, nichts ergänzt. */
const fragen: Frage[] | undefined = seite === "organisation"
  ? w.organisation.fragen.liste.map((q) => ({ f: q.f, a: q.a }))
  : undefined;

const auszeichnung = graph({
  seite: seite as "start" | "kulinarik" | "wein" | "organisation",
  sprache: kuerzel[lang].html,
  weg: canonical.href,
  titel: title,
  beschreibung: description,
  bild: preview.href,
  anmeldung: voll(pfad(lang, "anmeldung")),
  brotkrumen,
  hauptsache,
  fragen,
});
---
<!DOCTYPE html>
<html lang={kuerzel[lang].html}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternativen.map((f) => <link rel="alternate" hreflang={f.html} href={f.url} />)}
  <link rel="alternate" hreflang="x-default" href={standardweg} />
  <meta name="theme-color" content="#08090A" />
  <link rel="icon" href="/favicon.svg" />
  <ClientRouter />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={anlass.name} />
  <meta property="og:locale" content={kuerzel[lang].og} />
  {alternativen.filter((f) => f.lang !== lang).map((f) => (
    <meta property="og:locale:alternate" content={kuerzel[f.lang].og} />
  ))}
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={preview} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={preview} />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(auszeichnung)} />
</head>
<body>
  <div id="pg"></div>
  <Header lang={lang} seite={seite} />
  <slot />
  <Partner lang={lang} />
  <Footer lang={lang} />
  <script src="../scripts/site.js"></script>
</body>
</html>

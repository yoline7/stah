---
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Partner from "../components/Partner.astro";
import { anlass } from "../data/anlass";

interface Props {
  title: string;
  description: string;
  jsonld?: boolean;
}
const { title, description, jsonld = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = new URL("/preview.jpg", Astro.site);
---
<!DOCTYPE html>
<html lang="de-CH">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#08090A" />
  <link rel="icon" href="/favicon.svg" />

  <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,600&f[]=cabinet-grotesk@500,700,800&display=swap" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={anlass.name} />
  <meta property="og:locale" content="de_CH" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={preview} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={preview} />

  {jsonld && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FoodEvent",
      name: anlass.name,
      description,
      startDate: `${anlass.datumIso}T${anlass.beginn}:00+02:00`,
      endDate: `${anlass.datumIso}T${anlass.ende}:00+02:00`,
      eventStatus: "https://schema.org/EventScheduled",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      image: preview.href,
      url: canonical.href,
      inLanguage: "de-CH",
      maximumAttendeeCapacity: anlass.plaetze,
      typicalAgeRange: `${anlass.mindestalter}-`,
      location: {
        "@type": "Place",
        name: anlass.ort,
        address: { "@type": "PostalAddress", addressLocality: anlass.dorf,
                   postalCode: "3970", addressRegion: "Wallis", addressCountry: "CH" }
      },
      organizer: { "@type": "Organization", name: "Fernand Cina SA", url: "https://www.fernand-cina.ch/" },
      performer: [ { "@type": "Person", name: "Alisha Cina" }, { "@type": "Person", name: "Alain Lerjen" } ],
      offers: { "@type": "Offer", price: anlass.preis.toFixed(2), priceCurrency: "CHF",
                url: `${Astro.site}anmeldung`, availability: "https://schema.org/InStock",
                validThrough: `${anlass.anmeldeschlussIso}T23:59:00+02:00` }
    })} />
  )}
</head>
<body>
  <div id="pg"></div>
  <div id="cur"><div class="ring"></div><div class="dot"></div></div>
  <Header />
  <slot />
  <Partner />
  <Footer />
  <script src="../scripts/site.js"></script>
</body>
</html>

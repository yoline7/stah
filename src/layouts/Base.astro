---
import { ClientRouter } from "astro:transitions";
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Partner from "../components/Partner.astro";
import { anlass } from "../data/anlass";
import { fassungen, kuerzel, standard, type Sprache, type Seite } from "../i18n/sprachen";

interface Props {
  lang: Sprache;
  seite: Seite;
  title: string;
  description: string;
  jsonld?: boolean;
}
const { lang, seite, title, description, jsonld = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = new URL("/preview.jpg", Astro.site);
const alternativen = fassungen(seite).map((f) => ({ ...f, url: new URL(f.weg, Astro.site).href }));
const standardweg = alternativen.find((f) => f.lang === standard)!.url;
---
<!DOCTYPE html>
<html lang={kuerzel[lang].html}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternativen.map((f) => <link rel="alternate" hreflang={f.html} href={f.url} />)}
  <link rel="alternate" hreflang="x-default" href={standardweg} />
  <meta name="theme-color" content="#08090A" />
  <link rel="icon" href="/favicon.svg" />
  <ClientRouter />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={anlass.name} />
  <meta property="og:locale" content={kuerzel[lang].og} />
  {alternativen.filter((f) => f.lang !== lang).map((f) => (
    <meta property="og:locale:alternate" content={kuerzel[f.lang].og} />
  ))}
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={preview} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={preview} />

  {jsonld && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FoodEvent",
      name: anlass.name,
      description,
      startDate: `${anlass.datumIso}T${anlass.beginn}:00+02:00`,
      endDate: `${anlass.datumIso}T${anlass.ende}:00+02:00`,
      eventStatus: "https://schema.org/EventScheduled",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      image: preview.href,
      url: canonical.href,
      inLanguage: ["de-CH", "fr-CH", "en"],
      maximumAttendeeCapacity: anlass.plaetze,
      typicalAgeRange: `${anlass.mindestalter}-`,
      location: {
        "@type": "Place",
        name: anlass.ort,
        address: { "@type": "PostalAddress", addressLocality: anlass.dorf,
                   postalCode: "3970", addressRegion: "Wallis", addressCountry: "CH" }
      },
      organizer: { "@type": "Organization", name: "Fernand Cina SA", url: "https://www.fernand-cina.ch/" },
      performer: [ { "@type": "Person", name: "Alisha Cina" }, { "@type": "Person", name: "Alain Lerjen" } ],
      offers: { "@type": "Offer", price: anlass.preis.toFixed(2), priceCurrency: "CHF",
                url: `${Astro.site}anmeldung`, availability: "https://schema.org/InStock",
                validThrough: `${anlass.anmeldeschlussIso}T23:59:00+02:00` }
    })} />
  )}
</head>
<body>
  <div id="pg"></div>
  <div id="cur"><div class="ring"></div><div class="dot"></div></div>
  <Header lang={lang} seite={seite} />
  <slot />
  <Partner lang={lang} />
  <Footer lang={lang} />
  <script src="../scripts/site.js"></script>
</body>
</html>

---
import "@fontsource-variable/schibsted-grotesk";
import "../styles/anmeldung.css";
import Wortmarke from "../components/logos/Wortmarke.astro";
import Yoline from "../components/logos/Yoline.astro";
import { anlass } from "../data/anlass";
---
<!DOCTYPE html>
<html lang="de-CH">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Anmeldung · {anlass.name}</title>
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#F4F4F2" />
</head>
<body>
<header id="hd">
  <a class="brand" href="/"><Wortmarke /></a>
  <a class="back mono" href="/"><span class="n">&#8599;</span><span>Zurück zum Anlass</span></a>
</header>

<section class="wrap top">
  <div class="grid">
    <h1 class="disp">Anmeldung</h1>
    <p class="sub">{anlass.datum}, {anlass.ort} über {anlass.dorf}. {anlass.preisText} pro Person, {anlass.plaetze} Plätze, ab {anlass.mindestalter} Jahren. Anmeldung bis {anlass.anmeldeschluss}.</p>
  </div>
</section>

<section class="wrap main">
  <div class="grid">
    <div class="form" id="formular">

      <fieldset>
        <legend class="mono">( Wer kommt )</legend>
        <div class="fl"><span class="mono">Name</span><input type="text" id="name" placeholder="Vor- und Nachname"></div>
        <div class="two">
          <div class="fl"><span class="mono">E-Mail</span><input type="email" id="mail" placeholder="name@beispiel.ch"></div>
          <div class="fl"><span class="mono">Telefon, freiwillig</span><input type="tel" id="tel" placeholder="079 000 00 00"></div>
        </div>
        <div class="fl">
          <span class="mono">Sprache, freiwillig</span>
          <div class="chips" id="sprache">
            <label class="chip"><input type="radio" name="sprache" value="deutsch" checked><span>Deutsch</span></label>
            <label class="chip"><input type="radio" name="sprache" value="franzoesisch"><span>Französisch</span></label>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend class="mono">( Plätze und Essen )</legend>
        <div class="fl">
          <span class="mono">Anzahl Personen</span>
          <div class="chips" id="anzahl">
            <label class="chip"><input type="radio" name="anzahl" value="1"><span>1</span></label>
            <label class="chip"><input type="radio" name="anzahl" value="2" checked><span>2</span></label>
            <label class="chip"><input type="radio" name="anzahl" value="3"><span>3</span></label>
            <label class="chip"><input type="radio" name="anzahl" value="4"><span>4</span></label>
            <label class="chip"><input type="radio" name="anzahl" value="5"><span>5</span></label>
            <label class="chip"><input type="radio" name="anzahl" value="6"><span>6</span></label>
          </div>
        </div>
        <div id="gaeste"></div>
      </fieldset>

      <fieldset>
        <legend class="mono">( Bestätigung )</legend>
        <div class="ck"><input type="checkbox" id="zustimmung"><p>Ich bin 18 Jahre oder älter und habe die <a href="/agb">AGB</a> und die <a href="/teilnahmebedingungen">Teilnahmebedingungen</a> gelesen.<small>Kostenfreie Stornierung bis {anlass.anmeldeschluss}. Danach wird das Ticket verrechnet, weil die Küche eingekauft hat. Bei Verhinderung melde dich, wir suchen eine Lösung.</small></p></div>
        <div class="ck"><input type="checkbox" id="news"><p>Ja, ich möchte Post von Fernand Cina.<small>Neuigkeiten zu Weinen und Anlässen. Abmeldung jederzeit.</small></p></div>
      </fieldset>

      <button class="send" type="button" id="senden"><span>Anmeldung abschicken</span><span class="n">&#8599;</span></button>
      <p class="err mono" id="fehler">Name, E-Mail und die Bestätigung fehlen noch.</p>
      <p class="note">Nach dem Abschicken folgt die Zahlung. Die Bestätigung kommt sofort per Mail.</p>
    </div>

    <div class="side">
      <span class="mono sec">( Total )</span>
      <b id="totalwert">CHF 290.00</b>
      <span class="mono sec" id="teiler">2 Plätze · CHF 145.00</span>
      <ul>
        <li>Sieben Weine</li>
        <li>Sechs Gänge</li>
        <li>Shuttle hinauf und zurück</li>
        <li>Musik bis in den Abend</li>
        <li class="mono" style="padding-top:16px;">Getränke ab 14 Uhr separat</li>
      </ul>
    </div>

    <!-- YoSuite: bei 50 vergebenen Plaetzen #formular und .side ausblenden, #warteliste einblenden -->
    <div class="form" id="warteliste" hidden>
      <fieldset>
        <legend class="mono">( Warteliste )</legend>
        <p style="color:var(--sec-dark);max-width:44ch;margin-bottom:5vh;">Alle 50 Plätze sind vergeben. Trag dich ein, wir melden uns, sobald ein Platz frei wird.</p>
        <div class="fl"><span class="mono">Name</span><input type="text" id="w_name" placeholder="Vor- und Nachname"></div>
        <div class="two">
          <div class="fl"><span class="mono">E-Mail</span><input type="email" id="w_mail" placeholder="name@beispiel.ch"></div>
          <div class="fl"><span class="mono">Anzahl Personen</span><input type="text" id="w_anz" placeholder="1 bis 6"></div>
        </div>
      </fieldset>
      <button class="send" type="button"><span>Auf die Warteliste</span><span class="n">&#8599;</span></button>
      <p class="note">Die Warteliste ist unverbindlich und kostet nichts.</p>
    </div>

    <div class="danke" id="danke">
      <h2 class="head">Dein Platz ist reserviert.</h2>
      <p>Die Bestätigung ist unterwegs. Am 19. September um zehn Uhr in der Kellerei.</p>
      <p class="mono" style="color:var(--paper);">Alisha Cina und Alain Lerjen</p>
    </div>
  </div>
</section>


<footer class="wrap">
  <div class="in mono">
    <span><a href={`mailto:${anlass.mail}`}>{anlass.mail}</a></span>
    <span>
      <a href="/agb">AGB</a> ·
      <a href="/teilnahmebedingungen">Teilnahme</a> ·
      <a href="/impressum">Impressum</a> ·
      <a href="/datenschutz">Datenschutz</a>
    </span>
    <span>Website und Anmeldung <a href="https://yoline.ch" target="_blank" rel="noopener" style="display:inline-block;vertical-align:middle;line-height:0;margin-left:8px;"><Yoline class="yo" /></a></span>
  </div>
</footer>
<script src="../scripts/anmeldung.js"></script>
</body>
</html>

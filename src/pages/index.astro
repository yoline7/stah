---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import i_clos_du_cornalin from "../assets/img/clos-du-cornalin.jpg";
import i_team from "../assets/img/team.jpg";
import i_rebberg from "../assets/img/rebberg.jpg";
import i_alisha_cina from "../assets/img/alisha-cina.jpg";
import i_alain_lerjen from "../assets/img/alain-lerjen.jpg";
---
<Base title="z'Wallis im Stah · 19. September 2026" description="19. September 2026 im Clos du Cornalin über Salgesch. Sieben Weine, sechs Gänge, elektronische Musik bis in den Abend. CHF 145.00, 50 Plätze." jsonld>
<!-- HERO -->
<section class="hero" id="top">
  <div class="px" data-px="0.16"><Image src={i_clos_du_cornalin}
         alt="Rebhaus im Clos du Cornalin über Salgesch, dahinter das Rhonetal im Morgenlicht"
         widths={[960, 1440, 2000]} sizes="100vw" quality={72} format="webp"
         loading="eager" fetchpriority="high" /></div>
  <div class="veil"></div>
  <div class="in-b">
    <h1 class="disp">
      <span class="rl"><span>Dein Tag im Wallis</span></span>
      <span class="rl"><span>mit Wein, Kulinarik</span></span>
      <span class="rl"><span>und passenden Beats</span></span>
    </h1>
  </div>
  <span class="sc mono">Scrollen</span>
</section>

<!-- LAUFBAND -->
<div class="tick" aria-hidden="true">
  <div class="track mono">
    <span>Salgesch<i></i>19. September 2026<i></i>Clos du Cornalin<i></i>Sieben Weine<i></i>Sechs Gänge<i></i>50 Plätze<i></i>Salgesch<i></i>19. September 2026<i></i>Clos du Cornalin<i></i>Sieben Weine<i></i>Sechs Gänge<i></i>50 Plätze<i></i></span>
    <span>Salgesch<i></i>19. September 2026<i></i>Clos du Cornalin<i></i>Sieben Weine<i></i>Sechs Gänge<i></i>50 Plätze<i></i>Salgesch<i></i>19. September 2026<i></i>Clos du Cornalin<i></i>Sieben Weine<i></i>Sechs Gänge<i></i>50 Plätze<i></i></span>
  </div>
</div>

<!-- AUSSAGE -->
<section class="wrap s-a">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Der Anlass )</span></div>
    <div class="col-7">
      <h2 class="disp" style="max-width:11ch;">
        <span class="rl"><span>Drei Häuser.</span></span>
        <span class="rl"><span>Ein Rebberg.</span></span>
      </h2>
      <p class="bodyl fu d2" style="max-width:42ch;margin-top:9vh;">Der Clos du Cornalin liegt oberhalb von Salgesch. Von dort geht der Blick das Rhonetal hinauf und hinunter.</p>
      <p class="fu d3 sec" style="max-width:46ch;margin-top:4vh;">Die Idee kam von BergBox. Aus dem Wallis zusammenbringen, was zusammengehört. Fernand Cina macht hier seit 1956 Wein und öffnet Rebberg und Keller. Maison 13 baut die Küche auf, mitten unter den Gästen.</p>
      <p class="fu d3 sec" style="max-width:46ch;margin-top:3vh;">Daraus wird ein Tag im Stehen. Acht Stunden, sechs Gänge in Wellen, ab dem Nachmittag elektronische Musik. Dazwischen bewegst du dich, sprichst mit Leuten, schaust ins Tal.</p>
    </div>
  </div>
</section>

<!-- FAKTEN -->
<section class="wrap" style="padding-top:2vh;padding-bottom:16vh;">
  <div class="grid">
    <div class="col-full">
      <div class="facts fu">
        <div><b>7</b><span class="mono">Weine, ausgesucht von Alisha Cina</span></div>
        <div><b>6</b><span class="mono">Gänge von Alain Lerjen</span></div>
        <div><b>8</b><span class="mono">Stunden, zehn bis achtzehn Uhr</span></div>
        <div><b>1</b><span class="mono">Rebberg über dem Rhonetal</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ZWEI -->
<section class="wrap s-c" id="zwei" style="padding-top:4vh;">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Die zwei )</span></div>
    <div class="duo">
      <figure>
        <div class="ph mm"><div class="px" data-px="0.08"><Image src={i_alisha_cina}
               alt="Alisha Cina im schwarzen Shirt, lächelnd vor dem Rhonetal"
               widths={[480, 760, 1000]} sizes="(min-width: 900px) 34vw, 100vw"
               quality={80} format="webp" loading="lazy" /></div></div>
        <h3 class="fu">Alisha Cina</h3>
        <span class="mono fu d1">Weinbegleitung · Fernand Cina</span>
        <p class="fu d2">Dritte Generation im Familienbetrieb. Sie hat die sieben Weine ausgesucht und sagt jeden Gang an.</p>
      </figure>
      <figure>
        <div class="ph mm"><div class="px" data-px="0.08"><Image src={i_alain_lerjen}
               alt="Alain Lerjen im weissen Kochhemd im Profil, hinter ihm die Felswand"
               widths={[480, 760, 1000]} sizes="(min-width: 900px) 34vw, 100vw"
               quality={80} format="webp" loading="lazy" /></div></div>
        <h3 class="fu">Alain Lerjen</h3>
        <span class="mono fu d1">Küche · Maison 13</span>
        <p class="fu d2">Koch aus Zermatt, heute bei Maison 13. Bei ihm heisst kochen auch servieren und mit den Gästen reden.</p>
      </figure>
    </div>
  </div>
</section>

<!-- BAND 1 -->
<section class="band mm">
  <div class="px" data-px="0.2"><Image src={i_team}
         alt="Alisha Cina und Alain Lerjen im Kochhemd, hinter ihnen die Berge über dem Rhonetal"
         widths={[960, 1440, 2000]} sizes="100vw" quality={72} format="webp" loading="lazy" /></div>
  <div class="q">
    <h2 class="head fu">Zwei Häuser, ein Tisch.</h2>
    <span class="mono fu d2">Alisha Cina und Alain Lerjen</span>
  </div>
</section>

<!-- TAG -->
<section class="wrap s-c" id="tag">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Der Tag )</span></div>
    <div class="col-8 fu">
      <div class="reg">
        <div class="r"><div class="k mono sec">10:00</div><div class="v">Erster Wein in der Kellerei</div><div class="a mono">Salgesch</div></div>
        <div class="r"><div class="k mono sec">ab 10:30</div><div class="v">Hinauf zum Clos du Cornalin</div><div class="a mono">Shuttle</div></div>
        <div class="r"><div class="k mono sec">11:15</div><div class="v">Erster Gang</div><div class="a mono">Küche</div></div>
        <div class="r"><div class="k mono sec">bis 14:00</div><div class="v">Sechs Gänge, sechs Weine</div><div class="a mono">Geführt</div></div>
        <div class="r"><div class="k mono sec">ab 14:00</div><div class="v">Bar und elektronische Sounds bis sechs</div><div class="a mono">Ausklang</div></div>
        <div class="r"><div class="k mono sec">18:00</div><div class="v">Ende</div><div class="a mono">Rückfahrt</div></div>
      </div>
    </div>
  </div>
</section>

<!-- TEASER -->
<section class="wrap s-b">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Mehr dazu )</span></div>
    <div class="col-8 fu">
      <div class="arrows">
        <a class="arw" href="/kulinarik">
          <span><span class="t">Kulinarik</span><em class="sub">Sechs Gänge von Alain Lerjen, zwei Schienen, offene Stationen</em></span>
          <span class="n">&#8599;</span></a>
        <a class="arw" href="/wein">
          <span><span class="t">Wein</span><em class="sub">Sieben Weine von Alisha Cina, aus eigenem Rebland</em></span>
          <span class="n">&#8599;</span></a>
        <a class="arw" href="/organisation">
          <span><span class="t">Organisation</span><em class="sub">Anfahrt, Shuttle, Fragen und Kontakt</em></span>
          <span class="n">&#8599;</span></a>
      </div>
    </div>
  </div>
</section>

<!-- BAND 2 -->
<section class="band mm">
  <div class="px" data-px="0.18"><Image src={i_rebberg}
         alt="Rebberge über Salgesch, dahinter das Rhonetal und die Hänge des Pfynwaldes"
         widths={[960, 1440, 2000]} sizes="100vw" quality={72} format="webp" loading="lazy" /></div>
  <div class="q">
    <h2 class="head fu">Der Rest steht am 19. September oben in den Reben.</h2>
    <span class="mono fu d2">Samstag, 19. September 2026 · Clos du Cornalin</span>
  </div>
</section>

<!-- ABSCHLUSS -->
<section class="wrap s-d alt" id="anmeldung">
  <div class="grid">
    <div class="col-8">
      <h2 class="disp">
        <span class="rl"><span>50 Plätze.</span></span>
        <span class="rl"><span>Einer davon</span></span>
        <span class="rl"><span>ist deiner.</span></span>
      </h2>
      <div class="facts fu d2" style="margin-top:8vh;">
        <div><b>50</b><span class="mono">Plätze, ab 18 Jahren</span></div>
        <div><b>145<i>CHF</i></b><span class="mono">Weine, Gänge und Shuttle inbegriffen</span></div>
        <div><b>12.<i>SEP</i></b><span class="mono">Anmeldeschluss, danach kauft die Küche ein</span></div>
      </div>
      <a class="send fu d3" style="margin-top:7vh;" href="/anmeldung"><span>Zur Anmeldung</span><span class="n">&#8599;</span></a>
      <p class="fu d3 sec" style="margin-top:4vh;max-width:40ch;">Sind alle Plätze vergeben, führt derselbe Weg auf die Warteliste.</p>
    </div>
  </div>
</section>


</Base>

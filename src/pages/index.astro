---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { anlass } from "../data/anlass";
import i_clos_morgenlicht from "../assets/img/clos-morgenlicht.jpg";
import i_mood_messer from "../assets/img/mood-messer.jpg";
import i_rebberg from "../assets/img/rebberg.jpg";
import i_alisha_cina from "../assets/img/alisha-cina.jpg";
import i_alain_lerjen from "../assets/img/alain-lerjen.jpg";

// Anmeldeschluss fuer das Faktenfeld, Tag und Monat aus der Datendatei
const monate = ["JAN", "FEB", "MRZ", "APR", "MAI", "JUN", "JUL", "AUG", "SEP", "OKT", "NOV", "DEZ"];
const [, schlussMonat, schlussTag] = anlass.anmeldeschlussIso.split("-");
const schlussKurz = { tag: `${Number(schlussTag)}.`, monat: monate[Number(schlussMonat) - 1] };
---
<Base title="z'Wallis im Stah · 19. September 2026" description="19. September 2026 im Clos du Cornalin über Salgesch. Sieben Weine, sechs Gänge, elektronische Musik bis in den Abend. CHF 145.00, 50 Plätze." jsonld>
<!-- HERO -->
<section class="hero" id="top">
  <div class="px" data-px="0.16"><Image src={i_clos_morgenlicht}
         alt="Rebhaus im Clos du Cornalin über den Rebzeilen, dahinter das Rhonetal im Morgenlicht"
         widths={[960, 1440, 2000]} sizes="100vw" quality={72} format="webp"
         loading="eager" fetchpriority="high" /></div>
  <div class="veil"></div>
  <div class="in-b">
    <h1 class="disp">
      <span class="rl"><span>Dein Tag im Wallis</span></span>
      <span class="rl"><span>mit Wein, Kulinarik</span></span>
      <span class="rl"><span>und passenden Beats</span></span>
    </h1>
  </div>
  <span class="sc mono">Scrollen</span>
</section>

<!-- LAUFBAND -->
<div class="tick" aria-hidden="true">
  <div class="track mono">
    <span>Salgesch<i></i>19. September 2026<i></i>Clos du Cornalin<i></i>Sieben Weine<i></i>Sechs Gänge<i></i>50 Plätze<i></i>Salgesch<i></i>19. September 2026<i></i>Clos du Cornalin<i></i>Sieben Weine<i></i>Sechs Gänge<i></i>50 Plätze<i></i></span>
    <span>Salgesch<i></i>19. September 2026<i></i>Clos du Cornalin<i></i>Sieben Weine<i></i>Sechs Gänge<i></i>50 Plätze<i></i>Salgesch<i></i>19. September 2026<i></i>Clos du Cornalin<i></i>Sieben Weine<i></i>Sechs Gänge<i></i>50 Plätze<i></i></span>
  </div>
</div>

<!-- AUSSAGE -->
<section class="wrap s-a">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Der Anlass )</span></div>
    <div class="col-7">
      <h2 class="disp" style="max-width:11ch;">
        <span class="rl"><span>Drei Partner.</span></span>
        <span class="rl"><span>Ein Tag.</span></span>
      </h2>
      <p class="bodyl fu d2" style="max-width:42ch;margin-top:9vh;">{anlass.name} entstand aus einer gemeinsamen Idee von Fernand Cina, Maison 13 und BergBox.</p>
      <p class="fu d3 sec" style="max-width:46ch;margin-top:4vh;">Fernand Cina öffnet den Rebberg und die Kellerei. Maison 13 bringt die Küche mitten unter die Gäste. BergBox hält den Faden zusammen und hat die Umsetzung lanciert.</p>
      <p class="fu d3 sec" style="max-width:46ch;margin-top:3vh;">Ein ganzer Tag mitten in den Reben. Sechs Gänge. Sieben Weine. Elektronische Musik. Persönlich begleitet von Menschen aus dem Wallis.</p>
    </div>
  </div>
</section>

<!-- FAKTEN -->
<section class="wrap" style="padding-top:2vh;padding-bottom:16vh;">
  <div class="grid">
    <div class="col-full">
      <div class="facts fu">
        <div><b>7</b><span class="mono">Weine, ausgesucht von Alisha Cina</span></div>
        <div><b>6</b><span class="mono">Gänge von Alain Lerjen</span></div>
        <div><b>8</b><span class="mono">Stunden, zehn bis achtzehn Uhr</span></div>
        <div><b>1</b><span class="mono">Rebberg über dem Rhonetal</span></div>
      </div>
    </div>
  </div>
</section>

<!-- AUFTAKT -->
<section class="wrap s-c">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Der Auftakt )</span></div>
    <div class="col-7">
      <h2 class="head fu" style="max-width:15ch;">Dein Tag beginnt in der Kellerei.</h2>
      <p class="bodyl fu d2" style="max-width:44ch;margin-top:5vh;">Um {anlass.beginn} Uhr startet der Tag bei Fernand Cina in {anlass.dorf}.</p>
      <p class="fu d2 sec" style="max-width:46ch;margin-top:3vh;">Der erste Wein steht bereit. Danach geht es mit dem Shuttle hinauf zum {anlass.ort}.</p>
      <p class="fu d2 sec" style="max-width:46ch;margin-top:2.4vh;">Dort wird gekocht, gegessen und eingeschenkt. Die Küche bleibt offen, die Weine werden persönlich begleitet. Du bist mittendrin.</p>
    </div>
  </div>
</section>

<!-- ZWEI -->
<section class="wrap s-c" id="zwei" style="padding-top:4vh;">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Die zwei )</span></div>
    <div class="duo">
      <figure>
        <div class="ph mm"><div class="px" data-px="0.08"><Image src={i_alisha_cina}
               alt="Alisha Cina im schwarzen Shirt, lächelnd vor dem Rhonetal"
               widths={[480, 760, 1000]} sizes="(min-width: 900px) 34vw, 100vw"
               quality={80} format="webp" loading="lazy" /></div></div>
        <h3 class="fu">Alisha Cina</h3>
        <span class="mono fu d1">Wein · Fernand Cina</span>
        <span class="mono fu d1">Deutsch und Französisch</span>
        <p class="fu d2">Dritte Generation im Familienbetrieb. Alisha hat gemeinsam mit ihrem Vater Manfred die sieben Weine für den Tag ausgewählt und begleitet die Weinfolge persönlich.</p>
      </figure>
      <figure>
        <div class="ph mm"><div class="px" data-px="0.08"><Image src={i_alain_lerjen}
               alt="Alain Lerjen im weissen Kochhemd im Profil, hinter ihm die Felswand"
               widths={[480, 760, 1000]} sizes="(min-width: 900px) 34vw, 100vw"
               quality={80} format="webp" loading="lazy" /></div></div>
        <h3 class="fu">Alain Lerjen</h3>
        <span class="mono fu d1">Küche · Maison 13</span>
        <span class="mono fu d1">Deutsch und Französisch</span>
        <p class="fu d2">Koch aus Zermatt. Alain bringt die Küche von Maison 13 in den Rebberg und kocht direkt vor den Gästen.</p>
      </figure>
    </div>
  </div>
</section>

<!-- BAND 1 -->
<section class="band mm">
  <div class="px" data-px="0.2"><Image src={i_mood_messer}
         alt="Kochmesser mit Holzgriff auf verwitterten Holzbrettern"
         widths={[960, 1440, 2000]} sizes="100vw" quality={72} format="webp" loading="lazy" /></div>
  <div class="q">
    <h2 class="head fu">Sechs Gänge. Alle vor dir angerichtet.</h2>
    <span class="mono fu d2">Maison 13 im Rebberg</span>
  </div>
</section>

<!-- TAG -->
<section class="wrap s-c" id="tag">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Der Tag )</span></div>
    <div class="col-8 fu">
      <div class="reg">
        <div class="r"><div class="k mono sec">{anlass.beginn}</div><div class="v">Empfang in der Kellerei</div><div class="a mono">{anlass.dorf}</div></div>
        <div class="r"><div class="k mono sec">ab 10:30</div><div class="v">Hinauf zum {anlass.ort}</div><div class="a mono">Shuttle</div></div>
        <div class="r"><div class="k mono sec">11:15</div><div class="v">Erster Gang</div><div class="a mono">Küche</div></div>
        <div class="r"><div class="k mono sec">bis 14:00</div><div class="v">Sechs Gänge und sieben Weine</div><div class="a mono">Geführt</div></div>
        <div class="r"><div class="k mono sec">ab 14:00</div><div class="v">Bar und Beats</div><div class="a mono">Ausklang</div></div>
        <div class="r"><div class="k mono sec">{anlass.ende}</div><div class="v">Ende und Rückfahrt</div><div class="a mono">Shuttle</div></div>
      </div>
    </div>
  </div>
</section>

<!-- BEATS -->
<section class="wrap s-e on-dark">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Ab vierzehn Uhr )</span></div>
    <div class="col-7">
      <h2 class="head fu" style="max-width:14ch;">Und dann kommen die Beats.</h2>
      <p class="fu d2 sec" style="max-width:46ch;margin-top:4vh;">Ab 14 Uhr wird aus dem kulinarischen Tag ein langer Nachmittag. Bar. Elektronische Musik. Rebberg.</p>
      <p class="fu d2 sec" style="max-width:46ch;margin-top:2.4vh;">Bleib bei deinem Glas. Beweg dich zwischen den Reben. Triff die Menschen am Tisch.</p>
    </div>
  </div>
</section>

<!-- ORT -->
<section class="wrap s-c">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Der Ort )</span></div>
    <div class="col-7">
      <h2 class="head fu" style="max-width:14ch;">{anlass.ort}</h2>
      <p class="bodyl fu d2" style="max-width:44ch;margin-top:5vh;">Oberhalb von {anlass.dorf}. Zwischen den Reben. Mit Blick über das Rhonetal.</p>
      <p class="fu d2 sec" style="max-width:46ch;margin-top:3vh;">Der {anlass.ort} gehört zu Fernand Cina und gibt dem Tag seinen Rahmen.</p>
      <div class="weg fu d2">
        <div><span class="mono">Hier wächst der Wein</span><p>20 Hektaren eigenes Rebland rund um {anlass.dorf}.</p></div>
        <div><span class="mono">Hier wird gekocht</span><p>Die Küche von Maison 13 steht mitten im Rebberg.</p></div>
        <div><span class="mono">Hier ist der Tag</span><p>{anlass.plaetze} Menschen verbringen ihn gemeinsam.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- TEASER -->
<section class="wrap s-b">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Mehr dazu )</span></div>
    <div class="col-8 fu">
      <div class="arrows">
        <a class="arw" href="/kulinarik">
          <span><span class="t">Kulinarik</span><em class="sub">Sechs Gänge von Alain Lerjen, zwei Schienen, offene Stationen</em></span>
          <span class="n">&#8599;</span></a>
        <a class="arw" href="/wein">
          <span><span class="t">Wein</span><em class="sub">Sieben Weine von Alisha Cina, aus eigenem Rebland</em></span>
          <span class="n">&#8599;</span></a>
        <a class="arw" href="/organisation">
          <span><span class="t">Organisation</span><em class="sub">Anfahrt, Shuttle, Fragen und Kontakt</em></span>
          <span class="n">&#8599;</span></a>
      </div>
    </div>
  </div>
</section>

<!-- BAND 2 -->
<section class="band mm">
  <div class="px" data-px="0.18"><Image src={i_rebberg}
         alt="Rebberge über Salgesch, dahinter das Rhonetal und die Hänge des Pfynwaldes"
         widths={[960, 1440, 2000]} sizes="100vw" quality={72} format="webp" loading="lazy" /></div>
  <div class="q">
    <h2 class="head fu">Der Rest steht am 19. September oben in den Reben.</h2>
    <span class="mono fu d2">Samstag, 19. September 2026 · Clos du Cornalin</span>
  </div>
</section>

<!-- ABSCHLUSS -->
<section class="wrap s-d alt" id="anmeldung">
  <div class="grid">
    <div class="col-8">
      <h2 class="disp">
        <span class="rl"><span>50 Plätze.</span></span>
        <span class="rl"><span>Einer davon</span></span>
        <span class="rl"><span>ist deiner.</span></span>
      </h2>
      <div class="facts fu d2" style="margin-top:8vh;">
        <div><b>50</b><span class="mono">Plätze, ab 18 Jahren</span></div>
        <div><b>145<i>CHF</i></b><span class="mono">Weine, Gänge und Shuttle inbegriffen</span></div>
        <div><b>{schlussKurz.tag}<i>{schlussKurz.monat}</i></b><span class="mono">Anmeldeschluss, danach kauft die Küche ein</span></div>
      </div>
      <a class="send fu d3" style="margin-top:7vh;" href="/anmeldung"><span>Zur Anmeldung</span><span class="n">&#8599;</span></a>
      <p class="fu d3 sec" style="margin-top:4vh;max-width:40ch;">Ein kleiner Rahmen gehört zu diesem Tag dazu. Sind alle Plätze vergeben, führt derselbe Weg auf die Warteliste.</p>
    </div>
  </div>
</section>


</Base>

---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { anlass } from "../data/anlass";
import i_clos_du_cornalin from "../assets/img/clos-du-cornalin.jpg";
import i_alain_lerjen from "../assets/img/alain-lerjen.jpg";
---
<Base title="Kulinarik · z'Wallis im Stah" description="Sechs Gänge von Alain Lerjen und Maison 13, an offenen Stationen. Fleisch oder vegetarisch, Herkunft aus dem Wallis.">
<!-- KOPF -->
<section class="wrap" style="padding-top:22vh;padding-bottom:12vh;">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Kulinarik )</span></div>
    <div class="col-7">
      <h1 class="disp" style="max-width:13ch;">Sechs Gänge. Offen gekocht.</h1>
      <p class="bodyl fu d2" style="max-width:44ch;margin-top:7vh;">Alain Lerjen und Maison 13 bringen die Küche mitten in den Rebberg.</p>
      <p class="fu d3 sec" style="max-width:46ch;margin-top:3vh;">Die Gänge entstehen vor dir. Angerichtet wird direkt an den offenen Stationen.</p>
    </div>
  </div>
</section>

<!-- MENUE -->
<section class="wrap s-d on-dark" id="menu" style="padding-top:12vh;">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Sechs Gänge )</span></div>
    <div class="col-8">
      <h2 class="head fu" style="max-width:18ch;">Sechs Gänge. Ein Tag aus dem Wallis.</h2>
      <p class="fu d2 sec" style="max-width:46ch;margin:3vh 0 4vh 0;">Zu jedem Gang gehört ein Wein. Welcher es ist, verrät dir Alisha Cina vor Ort.</p>
      <p class="fu d3 sec" style="max-width:50ch;margin:0 0 9vh 0;padding-top:22px;border-top:1px solid var(--hair-dark);">Die Weine stammen aus 20 Hektaren eigenem Rebland. Der {anlass.ort} des Jahrgangs 2020 erhielt an der Expovina Wine Trophy in Zürich 93.4 Punkte, die höchstbenotete Goldmedaille.</p>
      <div class="mn fu">
        <div class="g"><div class="rn mono">·</div><div class="ti">Empfang in der Kellerei</div><div class="wn mono">Schaumwein</div></div>
        <div class="g"><div class="rn mono">I</div><div class="ti">Kürbiscremesuppe im Glas</div><div class="wn mono">Weiss</div></div>
        <div class="g"><div class="rn mono">II</div><div class="ti">Knusprige Reiskugel mit Munder Safran</div><div class="wn mono">Weiss</div></div>
        <div class="g"><div class="rn mono">III</div><div class="ti">Eringer-Tatar auf Hausbrot<em>Vegetarisch: Karotte und Rande</em></div><div class="wn mono">Rot</div></div>
        <div class="g"><div class="rn mono">IV</div><div class="ti">Walliser Handroll<em>Vegetarisch ohne Fleisch</em></div><div class="wn mono">Rot</div></div>
        <div class="g"><div class="rn mono">V</div><div class="ti">Käse-Fondue im heissen Stein</div><div class="wn mono">Weiss</div></div>
        <div class="g"><div class="rn mono">VI</div><div class="ti">Joghurt-Parfait mit Waldbeeren</div><div class="wn mono">Süsswein</div></div>
      </div>
    </div>
  </div>
</section>

<!-- WAHL -->
<section class="wrap s-c">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Die Wahl )</span></div>
    <div class="col-7">
      <h2 class="head fu" style="max-width:14ch;">Fleisch oder vegetarisch.</h2>
      <p class="bodyl fu d2" style="max-width:44ch;margin-top:5vh;">Du entscheidest bei der Anmeldung.</p>
      <p class="fu d2 sec" style="max-width:46ch;margin-top:3vh;">Die vegetarische Variante wird über die gesamte Menüfolge angepasst. Die Wahl ist verbindlich, sie steuert den Einkauf der Küche.</p>
    </div>
  </div>
</section>

<!-- BAND -->
<section class="band mm">
  <div class="px" data-px="0.18"><Image src={i_clos_du_cornalin}
         alt="Rebhaus im Clos du Cornalin über Salgesch, dahinter das Rhonetal im Morgenlicht"
         widths={[960, 1440, 2000]} sizes="100vw" quality={72} format="webp" loading="lazy" /></div>
  <div class="q">
    <h2 class="head fu">Angerichtet wird vor dir.</h2>
    <span class="mono fu d2">Offene Stationen im Rebhaus</span>
  </div>
</section>

<!-- KOCH -->
<section class="wrap s-c">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Der Koch )</span></div>
    <div class="col-7">
      <h2 class="head fu" style="max-width:15ch;">Angerichtet wird vor dir. Offene Stationen im Rebhaus.</h2>
    </div>
    <div class="duo" style="grid-template-columns:1fr;margin-top:6vh;">
      <figure style="max-width:520px;">
        <div class="ph mm"><div class="px" data-px="0.08"><Image src={i_alain_lerjen}
               alt="Alain Lerjen im weissen Kochhemd im Profil, hinter ihm die Felswand"
               widths={[480, 760, 1000]} sizes="(min-width: 900px) 520px, 100vw"
               quality={80} format="webp" loading="lazy" /></div></div>
        <h3 class="fu">Alain Lerjen</h3>
        <span class="mono fu d1">Küche · Maison 13</span>
        <p class="fu d2 sec" style="max-width:48ch;">Alain ist Koch aus Zermatt und heute bei Maison 13. Er kocht gerne für Menschen. Und er ist gerne dort, wo gekocht, serviert und gesprochen wird.</p>
        <p class="fu d2 sec" style="max-width:48ch;margin-top:2.4vh;">Gault Millau schrieb 2021, er koche fürs Leben gerne und stehe ebenso gerne an der Front. Genau das bringt er am {anlass.datum} in den {anlass.ort}.</p>
      </figure>
    </div>
    <div class="col-7">
      <div class="weg fu d2">
        <div><span class="mono">Kein Buffet</span><p>Alain Lerjen kocht nicht hinter einer Tür. Er steht dort, wo auch die Gäste sind.</p></div>
        <div><span class="mono">Frisch angerichtet</span><p>Die Gänge werden angerichtet, angesagt und direkt ausgegeben.</p></div>
        <div><span class="mono">Kein fertiger Teller</span><p>Nichts wartet auf dich. Die Küche ist Teil des Tages.</p></div>
        <div><span class="mono">Allergien</span><p>Bis {anlass.anmeldeschluss} melden, per Antwort auf die Bestätigungsmail.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- HERKUNFT -->
<section class="wrap s-e alt">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Herkunft )</span></div>
    <div class="col-7">
      <h2 class="head fu" style="max-width:15ch;">Aus dem Wallis.</h2>
      <p class="fu d2 sec" style="max-width:46ch;margin-top:3vh;">Die Produkte erzählen ihren eigenen Teil der Geschichte.</p>
      <div class="weg fu d2">
        <div><span class="mono">Munder Safran</span><p>Aus Mund, dem einzigen Safrandorf der Schweiz.</p></div>
        <div><span class="mono">Eringer</span><p>Das Fleisch der Walliser Rinderrasse.</p></div>
        <div><span class="mono">Walliser Alpkäse</span><p>Für das Fondue im heissen Stein.</p></div>
        <div><span class="mono">Waldbeeren</span><p>Für den Abschluss.</p></div>
        <div><span class="mono">Der Wein</span><p>Aus dem eigenen Rebland von Fernand Cina, 20 Hektaren rund um {anlass.dorf}.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- AUFRUF -->
<section class="wrap s-e alt">
  <div class="grid">
    <div class="col-8">
      <h2 class="head fu" style="max-width:20ch;">Ein Empfang. Sechs Gänge. Sieben Weine.</h2>
      <p class="fu d2 sec" style="max-width:40ch;margin-top:3vh;">{anlass.preisText} pro Person, maximal {anlass.plaetze} Plätze. {anlass.datum}, {anlass.ort} über {anlass.dorf}. Anmeldung bis {anlass.anmeldeschluss}.</p>
      <a class="send fu d3" href="/anmeldung"><span>Zur Anmeldung</span><span class="n">&#8599;</span></a>
    </div>
  </div>
</section>


</Base>

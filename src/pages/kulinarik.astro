---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import i_mood_messer from "../assets/img/mood-messer.jpg";
import i_alain_lerjen from "../assets/img/alain-lerjen.jpg";
---
<Base title="Kulinarik · z'Wallis im Stah" description="Sechs Gänge von Alain Lerjen und Maison 13, an offenen Stationen. Fleisch oder vegetarisch, Herkunft aus dem Wallis.">
<!-- KOPF -->
<section class="wrap" style="padding-top:22vh;padding-bottom:12vh;">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Kulinarik )</span></div>
    <div class="col-7">
      <h1 class="disp" style="max-width:13ch;">Sechs Gänge, offen gekocht.</h1>
      <p class="bodyl fu d2" style="max-width:44ch;margin-top:7vh;">Alain Lerjen und Maison 13 bauen die Küche mitten unter die Gäste. Angerichtet wird vor dir.</p>
    </div>
  </div>
</section>

<!-- MENUE -->
<section class="wrap s-d on-dark" id="menu" style="padding-top:12vh;">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Sechs Gänge )</span></div>
    <div class="col-8">
      <h2 class="head fu" style="max-width:16ch;">Sechs Gänge. Zu jedem ein Wein.</h2>
      <p class="fu d2 sec" style="max-width:46ch;margin:3vh 0 4vh 0;">Fleisch oder vegetarisch, du entscheidest bei der Anmeldung. Welcher Wein zu welchem Gang kommt, sagt dir Alisha Cina vor Ort.</p>
      <p class="fu d3 sec" style="max-width:50ch;margin:0 0 9vh 0;padding-top:22px;border-top:1px solid var(--hair-dark);">Die Weine stammen aus 20 Hektaren eigenem Rebland. Der Clos du Cornalin des Jahrgangs 2020 erhielt an der Expovina Wine Trophy in Zürich 93.4 Punkte, die höchstbenotete Goldmedaille.</p>
      <div class="mn fu">
        <div class="g"><div class="rn mono">·</div><div class="ti">Empfang in der Kellerei</div><div class="wn mono">Schaumwein</div></div>
        <div class="g"><div class="rn mono">I</div><div class="ti">Kürbiscremesuppe im Glas</div><div class="wn mono">Weiss</div></div>
        <div class="g"><div class="rn mono">II</div><div class="ti">Knusprige Reiskugel, Munder Safran</div><div class="wn mono">Weiss</div></div>
        <div class="g"><div class="rn mono">III</div><div class="ti">Eringer-Tatar auf Hausbrot<em>Vegetarisch: Karotte und Rande</em></div><div class="wn mono">Rot</div></div>
        <div class="g"><div class="rn mono">IV</div><div class="ti">Walliser Handroll<em>Vegetarisch ohne Fleisch</em></div><div class="wn mono">Rot</div></div>
        <div class="g"><div class="rn mono">V</div><div class="ti">Käse-Fondue im heissen Stein</div><div class="wn mono">Weiss</div></div>
        <div class="g"><div class="rn mono">VI</div><div class="ti">Joghurt-Parfait, Waldbeeren</div><div class="wn mono">Süsswein</div></div>
      </div>
    </div>
  </div>
</section>

<!-- BAND -->
<section class="band mm">
  <div class="px" data-px="0.18"><Image src={i_mood_messer}
         alt="Kochmesser mit Holzgriff auf verwitterten Holzbrettern"
         widths={[960, 1440, 2000]} sizes="100vw" quality={72} format="webp" loading="lazy" /></div>
  <div class="q">
    <h2 class="head fu">Angerichtet wird vor dir.</h2>
    <span class="mono fu d2">Offene Stationen im Rebberg</span>
  </div>
</section>

<!-- KOCH -->
<section class="wrap s-c">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Der Koch )</span></div>
    <div class="col-7">
      <h2 class="head fu" style="max-width:15ch;">Alain Lerjen kocht vor dir, nicht hinter einer Tür.</h2>
    </div>
    <div class="duo" style="grid-template-columns:1fr;margin-top:6vh;">
      <figure style="max-width:520px;">
        <div class="ph mm"><div class="px" data-px="0.08"><Image src={i_alain_lerjen}
               alt="Alain Lerjen im weissen Kochhemd im Profil, hinter ihm die Felswand"
               widths={[480, 760, 1000]} sizes="(min-width: 900px) 520px, 100vw"
               quality={80} format="webp" loading="lazy" /></div></div>
        <h3 class="fu">Alain Lerjen</h3>
        <span class="mono fu d1">Küche · Maison 13</span>
        <p class="fu d2 sec" style="max-width:48ch;">Koch aus Zermatt, heute bei Maison 13. Bei ihm heisst kochen auch servieren und mit den Gästen reden.</p>
        <p class="fu d2 sec" style="max-width:48ch;margin-top:2.4vh;">Gault Millau schrieb 2021, er koche fürs Leben gerne und stehe ebenso gerne an der Front. Genau so arbeitet er am 19. September: an offenen Stationen, mitten unter den Gästen.</p>
      </figure>
    </div>
    <div class="col-7">
      <div class="weg fu d2">
        <div><span class="mono">Kein Buffet</span><p>Jeder Gang wird angerichtet und ausgegeben. Brot und Wasser stehen frei.</p></div>
        <div><span class="mono">In Wellen</span><p>Die Gänge kommen nacheinander, jeder wird angesagt.</p></div>
        <div><span class="mono">Zwei Schienen</span><p>Fleisch oder vegetarisch über alle Gänge. Wahl bei der Anmeldung, verbindlich.</p></div>
        <div><span class="mono">Allergien</span><p>Bis 12. September melden, per Antwort auf die Bestätigungsmail.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- HERKUNFT -->
<section class="wrap s-e alt">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Herkunft )</span></div>
    <div class="col-7">
      <h2 class="head fu" style="max-width:15ch;">Alles von hier, fast alles zu Fuss erreichbar.</h2>
      <div class="weg fu d2">
        <div><span class="mono">Der Wein</span><p>20 Hektaren eigenes Rebland, alle rund um Salgesch.</p></div>
        <div><span class="mono">Der Safran</span><p>Aus Mund, dem einzigen Safrandorf der Schweiz, wenige Kilometer rheinaufwärts.</p></div>
        <div><span class="mono">Das Fleisch</span><p>Eringer, die Rinderrasse des Wallis.</p></div>
        <div><span class="mono">Der Käse</span><p>Fondue im heissen Stein, aus Walliser Alpkäse.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- AUFRUF -->
<section class="wrap s-e alt">
  <div class="grid">
    <div class="col-8">
      <h2 class="head fu" style="max-width:16ch;">50 Plätze. Einer davon ist deiner.</h2>
      <p class="fu d2 sec" style="max-width:40ch;margin-top:3vh;">CHF 145.00 pro Person. Anmeldung bis 12. September.</p>
      <a class="send fu d3" href="/anmeldung"><span>Zur Anmeldung</span><span class="n">&#8599;</span></a>
    </div>
  </div>
</section>


</Base>

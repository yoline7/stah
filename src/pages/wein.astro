---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { anlass } from "../data/anlass";
import i_rebhaus_drohne from "../assets/img/rebhaus-drohne.jpg";
import i_alisha_cina from "../assets/img/alisha-cina.jpg";
---
<Base title="Wein · z'Wallis im Stah" description="Sieben Weine, ausgesucht von Alisha Cina. Aus 20 Hektaren eigenem Rebland rund um Salgesch.">
<!-- KOPF -->
<section class="wrap" style="padding-top:22vh;padding-bottom:12vh;">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Wein )</span></div>
    <div class="col-7">
      <h1 class="disp" style="max-width:13ch;">Sieben Weine. Alishas Auswahl.</h1>
      <p class="bodyl fu d2" style="max-width:44ch;margin-top:7vh;">Gemeinsam mit ihrem Vater Manfred hat Alisha Cina die sieben Weine für diesen Tag ausgewählt. Alle aus dem eigenen Rebland rund um {anlass.dorf}.</p>
      <p class="fu d3 sec" style="max-width:46ch;margin-top:3vh;">Welche Weine es sind und welcher Gang sie begleitet, erfährst du erst am {anlass.datum}. Die Auswahl bleibt bis dahin ihr Geheimnis.</p>
    </div>
  </div>
</section>

<!-- BEGLEITUNG -->
<section class="wrap s-c">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Die Begleitung )</span></div>
    <div class="col-8 fu">
      <h2 class="head fu" style="max-width:18ch;margin-bottom:5vh;">Ein Empfang. Sechs Gänge. Sieben Weine.</h2>
      <div class="reg">
        <div class="r"><div class="k mono sec">Empfang</div><div class="v">Erster Wein in der Kellerei</div><div class="a mono">{anlass.beginn}</div></div>
        <div class="r"><div class="k mono sec">Gang I</div><div class="v">Weinbegleitung</div><div class="a mono">11:15</div></div>
        <div class="r"><div class="k mono sec">Gang II</div><div class="v">Weinbegleitung</div><div class="a mono">Clos</div></div>
        <div class="r"><div class="k mono sec">Gang III</div><div class="v">Weinbegleitung</div><div class="a mono">Clos</div></div>
        <div class="r"><div class="k mono sec">Gang IV</div><div class="v">Weinbegleitung</div><div class="a mono">Clos</div></div>
        <div class="r"><div class="k mono sec">Gang V</div><div class="v">Weinbegleitung</div><div class="a mono">Clos</div></div>
        <div class="r"><div class="k mono sec">Gang VI</div><div class="v">Weinbegleitung</div><div class="a mono">Clos</div></div>
      </div>
      <p class="fu d2 sec" style="max-width:46ch;margin-top:5vh;">Welche Weine Alisha ausgewählt hat und wie sie die einzelnen Gänge begleitet, erfährst du vor Ort.</p>
    </div>
  </div>
</section>

<!-- BAND 2 -->
<section class="band mm">
  <div class="px" data-px="0.18"><Image src={i_rebhaus_drohne}
         alt="Drohnenblick auf das Rebhaus zwischen den Rebzeilen des Clos du Cornalin"
         widths={[960, 1440, 2000]} sizes="100vw" quality={72} format="webp" loading="lazy" /></div>
  <div class="q">
    <h2 class="head fu">Sieben Weine aus eigenem Rebland.</h2>
    <span class="mono fu d2">20 Hektaren rund um Salgesch</span>
  </div>
</section>

<!-- HAUS -->
<section class="wrap s-d on-dark">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Das Weingut )</span></div>
    <div class="col-7">
      <h2 class="head fu" style="max-width:16ch;">Aus eigenem Rebland. 20 Hektaren rund um Salgesch.</h2>
      <p class="fu d2 sec" style="max-width:48ch;margin-top:4vh;">Fernand Cina bewirtschaftet rund 20 Hektaren eigenes Rebland rund um {anlass.dorf}. Der Familienbetrieb wurde 1956 gegründet und wird heute von Manfred und Damian Cina geführt. Über 40 Weine entstehen aus den eigenen Reben.</p>
      <p class="fu d2 sec" style="max-width:48ch;margin-top:2.4vh;">Der {anlass.ort} ist einer der besonderen Orte des Weinguts. Der Jahrgang 2020 erhielt an der Expovina Wine Trophy in Zürich 93.4 Punkte, die höchstbenotete Goldmedaille.</p>
      <p class="fu d2 sec" style="max-width:48ch;margin-top:2.4vh;">Am {anlass.datum} wird genau hier eingeschenkt.</p>
    </div>
  </div>
</section>

<!-- WINZERIN -->
<section class="wrap s-c">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Die Weinbegleitung )</span></div>
    <div class="duo" style="grid-template-columns:1fr;">
      <figure style="max-width:520px;">
        <div class="ph mm"><div class="px" data-px="0.08"><Image src={i_alisha_cina}
               alt="Alisha Cina im schwarzen Shirt, lächelnd vor dem Rhonetal"
               widths={[480, 760, 1000]} sizes="(min-width: 900px) 520px, 100vw"
               quality={80} format="webp" loading="lazy" /></div></div>
        <h3 class="fu">Alisha Cina</h3>
        <span class="mono fu d1">Weinbegleitung · Fernand Cina</span>
        <p class="fu d2" style="max-width:46ch;">Dritte Generation im Familienbetrieb. Alisha ist Winzerin und Weintechnologin, ausgebildet an der Ecole d'agriculture du Valais. Seit 2024 an der Ecole d'Ingénieurs de Changins, Fachrichtung Önologie.</p>
        <p class="fu d2" style="max-width:46ch;margin-top:14px;">Für {anlass.name} hat sie gemeinsam mit ihrem Vater Manfred die sieben Weine ausgewählt. Am {anlass.datum} stellt sie dir jeden Wein persönlich vor.</p>
      </figure>
    </div>
  </div>
</section>

<!-- AUFRUF -->
<section class="wrap s-e alt">
  <div class="grid">
    <div class="col-8">
      <h2 class="head fu" style="max-width:16ch;">{anlass.plaetze} Plätze. Eine persönliche Weinbegleitung.</h2>
      <p class="fu d2 sec" style="max-width:40ch;margin-top:3vh;">{anlass.preisText} pro Person. {anlass.datum}, {anlass.ort} über {anlass.dorf}. Anmeldung bis {anlass.anmeldeschluss}.</p>
      <a class="send fu d3" href="/anmeldung"><span>Zur Anmeldung</span><span class="n">&#8599;</span></a>
    </div>
  </div>
</section>


</Base>

---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { anlass } from "../data/anlass";
import i_rebhaus_drohne from "../assets/img/rebhaus-drohne.jpg";
import i_alisha_cina from "../assets/img/alisha-cina.jpg";
---
<Base title="Wein · z'Wallis im Stah" description="Sieben Weine, ausgesucht von Alisha Cina. Aus 20 Hektaren eigenem Rebland rund um Salgesch.">
<!-- KOPF -->
<section class="wrap" style="padding-top:22vh;padding-bottom:12vh;">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Wein )</span></div>
    <div class="col-7">
      <h1 class="disp" style="max-width:13ch;">Sieben Weine, ausgesucht von Alisha Cina.</h1>
      <p class="bodyl fu d2" style="max-width:44ch;margin-top:7vh;">Aus eigenem Rebland rund um Salgesch. Welche es sind, erfährst du am Tag selbst.</p>
    </div>
  </div>
</section>

<!-- BEGLEITUNG -->
<section class="wrap s-c">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Die Begleitung )</span></div>
    <div class="col-8 fu">
      <div class="reg">
        <div class="r"><div class="k mono sec">Empfang</div><div class="v">Schaumwein</div><div class="a mono">Kellerei</div></div>
        <div class="r"><div class="k mono sec">Gang I</div><div class="v">Weiss</div><div class="a mono">Clos</div></div>
        <div class="r"><div class="k mono sec">Gang II</div><div class="v">Weiss</div><div class="a mono">Clos</div></div>
        <div class="r"><div class="k mono sec">Gang III</div><div class="v">Rot</div><div class="a mono">Clos</div></div>
        <div class="r"><div class="k mono sec">Gang IV</div><div class="v">Rot</div><div class="a mono">Clos</div></div>
        <div class="r"><div class="k mono sec">Gang V</div><div class="v">Weiss</div><div class="a mono">Clos</div></div>
        <div class="r"><div class="k mono sec">Gang VI</div><div class="v">Süsswein</div><div class="a mono">Clos</div></div>
      </div>
      <p class="fu d2 sec" style="max-width:46ch;margin-top:5vh;">Welcher Wein zu welchem Gang kommt, sagt dir Alisha Cina vor Ort. Die Namen bleiben bis dahin offen.</p>
    </div>
  </div>
</section>

<!-- BAND 2 -->
<section class="band mm">
  <div class="px" data-px="0.18"><Image src={i_rebhaus_drohne}
         alt="Drohnenblick auf das Rebhaus zwischen den Rebzeilen des Clos du Cornalin"
         widths={[960, 1440, 2000]} sizes="100vw" quality={72} format="webp" loading="lazy" /></div>
  <div class="q">
    <h2 class="head fu">Sieben Weine aus eigenem Rebland.</h2>
    <span class="mono fu d2">20 Hektaren rund um Salgesch</span>
  </div>
</section>

<!-- HAUS -->
<section class="wrap s-d on-dark">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Das Weingut )</span></div>
    <div class="col-7">
      <h2 class="head fu" style="max-width:16ch;">20 Hektaren, alle rund um Salgesch.</h2>
      <p class="fu d2 sec" style="max-width:48ch;margin-top:4vh;">Fernand Cina gründete den Betrieb 1956. Heute führen ihn Manfred und Damian Cina, mit über vierzig Weinen aus eigenem Rebland.</p>
      <p class="fu d2 sec" style="max-width:48ch;margin-top:2.4vh;">Der Clos du Cornalin ist die Lage, die dem Haus den Namen gegeben hat. Der Jahrgang 2020 erhielt an der Expovina Wine Trophy in Zürich 93.4 Punkte, die höchstbenotete Goldmedaille.</p>
      <p class="fu d2 sec" style="max-width:48ch;margin-top:2.4vh;">Am 19. September steht der Anlass genau dort.</p>
    </div>
  </div>
</section>

<!-- WINZERIN -->
<section class="wrap s-c">
  <div class="grid">
    <div class="lab mono sec fu"><span class="stick">( Die Weinbegleitung )</span></div>
    <div class="duo" style="grid-template-columns:1fr;">
      <figure style="max-width:520px;">
        <div class="ph mm"><div class="px" data-px="0.08"><Image src={i_alisha_cina}
               alt="Alisha Cina im schwarzen Shirt, lächelnd vor dem Rhonetal"
               widths={[480, 760, 1000]} sizes="(min-width: 900px) 520px, 100vw"
               quality={80} format="webp" loading="lazy" /></div></div>
        <h3 class="fu">Alisha Cina</h3>
        <span class="mono fu d1">Dritte Generation</span>
        <p class="fu d2" style="max-width:46ch;">Winzerin und Weintechnologin, ausgebildet an der Ecole d'agriculture du Valais. Seit 2024 an der Ecole d'Ingénieurs de Changins, Fachrichtung Önologie.</p>
        <p class="fu d2" style="max-width:46ch;margin-top:14px;">Sie hat die sieben Weine für diesen Tag ausgesucht und sagt jeden Gang an.</p>
      </figure>
    </div>
  </div>
</section>

<!-- AUFRUF -->
<section class="wrap s-e alt">
  <div class="grid">
    <div class="col-8">
      <h2 class="head fu" style="max-width:16ch;">50 Plätze. Einer davon ist deiner.</h2>
      <p class="fu d2 sec" style="max-width:40ch;margin-top:3vh;">{anlass.preisText} pro Person. Anmeldung bis {anlass.anmeldeschluss}.</p>
      <a class="send fu d3" href="/anmeldung"><span>Zur Anmeldung</span><span class="n">&#8599;</span></a>
    </div>
  </div>
</section>


</Base>
